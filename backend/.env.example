# ----------------------------------------------------------------------
# gov-signal backend environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ----------------------------------------------------------------------

# --- App ---
# development | staging | production
APP_ENV=

# --- Database ---
# Example (docker-compose default):
# postgresql+psycopg://gov_signal:gov_signal_dev@localhost:5433/gov_signal
DATABASE_URL=

# --- Anthropic Claude API ---
# Get key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Recommended: claude-sonnet-4-6
ANTHROPIC_MODEL=

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
